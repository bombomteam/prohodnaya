# Пример настроек стенда для docker compose. Скопируйте в .env и поправьте.
# .env не коммитится (есть в .gitignore). Секреты храните только в .env на сервере.

# --- frontend ---
# Образ и версия. local — собрать из ./frontend; на сервере пайплайн подставит хеш коммита.
FRONTEND_IMAGE=ghcr.io/bombomteam/prohodnaya-frontend
FRONTEND_TAG=local

# Порт и адрес, на которых фронт доступен снаружи.
# 0.0.0.0 — из сети; 127.0.0.1 — только с этой машины (например, за reverse proxy).
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80

# demo — данные в браузере, без сервера; api — работа с бэкендом.
FRONTEND_MODE=demo
# Для api с бэкендом в этом же compose: API_UPSTREAM=http://backend:8000 (API_BASE_URL оставить пустым).
API_UPSTREAM=
# Для api с отдельным публичным HTTPS-бэкендом: API_BASE_URL=https://api.example.org/api
API_BASE_URL=

# --- Keycloak: локальный стенд, постоянная встроенная БД ---
# Локальная сборка или опубликованный образ в собственном registry.
KEYCLOAK_IMAGE=prohodnaya-keycloak
KEYCLOAK_TAG=local
KC_BIND=127.0.0.1
KC_PORT=8081
# Браузерный адрес; issuer = этот URL + /realms/construction.
KC_PUBLIC_URL=http://localhost:8081
# Для будущего backend: JWKS получать внутри сети Compose по этому URL.
KC_INTERNAL_URL=http://keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
# Обязательные секреты: заполнить только в .env, не в этом файле.
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_ADMIN1_PASSWORD=
KC_MANAGER1_PASSWORD=
KC_CONTROLLER1_PASSWORD=
# Точный callback URL фронта и origin (без завершающего /).
PANEL_REDIRECT_URI=http://localhost:8080/
PANEL_ORIGIN=http://localhost:8080
# Пусто локально; xforwarded только за доверенным HTTPS reverse proxy.
KC_PROXY_HEADERS=

# --- db (postgres:16) ---
# Секреты задаются только в .env на сервере.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- backend ---
# Включает db и backend; уберите, чтобы поднять только frontend.
COMPOSE_PROFILES=backend
# Хост внутри compose — db. Подставьте те же значения, что в POSTGRES_*.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db:5432/DBNAME
# Каталог файлов бэкенда (volume data): фото эталонов, план объекта.
DATA_DIR=/data
# Адреса фронтов для CORS, через запятую; добавьте адрес туннеля.
CORS_ORIGINS=http://localhost:5173
# Адрес фронта телефона — для ссылки активации (/enroll?code=...).
PUBLIC_APP_URL=
# Часовой пояс объекта: границы «дня» и фильтр часов считаются в нём.
SITE_TZ=Europe/Moscow
# Время жизни QR прохода, секунды.
PASS_SESSION_TTL_S=90
# Время жизни кода активации телефона, минуты.
ENROLL_CODE_TTL_MIN=60
# Порог похожести лица с эталоном (косинусная).
FACE_MATCH_THRESHOLD=0.4
# Сколько кадров из 3 должны совпасть с эталоном.
FACE_MIN_MATCHES=2
# Период отправки геоточек телефоном, секунды.
LOCATION_INTERVAL_S=30
# Максимальный возраст пачки геоточек, секунды (защита от повтора).
LOCATION_MAX_AGE_S=180
# true — только для локальной разработки до готовности Keycloak (вход без токена).
AUTH_DEV_BYPASS=false
# KC_PUBLIC_URL и KC_INTERNAL_URL (блок Keycloak выше) использует и бэкенд (core/auth.py).
# Публикация порта бэкенда на хосте (по умолчанию только localhost).
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
