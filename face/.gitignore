# Веса моделей — не в Git: скачиваются скриптом или при сборке образа.
/models/*
!/models/fetch_models.sh
*.onnx
*.pt
*.pth
*.bin
*.safetensors
*.tflite

# Результаты прогонов (в Git — только текстовый отчёт в docs/).
eval/out/

# Лица людей в Git не попадают никогда: любые изображения и видео в face/.
# Фото пакета кейса лежат в case_prerekvizity/ и этим правилом не затрагиваются.
*.jpg
*.jpeg
*.png
*.webp
*.heic
*.heif
*.gif
*.bmp
*.tif
*.tiff
*.mov
*.mp4
*.m4v
*.avi
*.webm

# Окружения
.venv/
__pycache__/
