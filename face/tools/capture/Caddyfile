# Временный HTTPS для страницы загрузки (face/tools/capture/server.py на 127.0.0.1:8765).
# Сертификат Let's Encrypt по TLS-ALPN на 443; порт 80 занят стендом, поэтому без редиректа.
# Запуск: run_https.sh. Только на время сбора тестовых данных.
{
	http_port 8088
	auto_https disable_redirects
	# HTTP/2 через этот прокси давал загрузку ~4 КБ/с; HTTP/1.1 — нормальная скорость
	servers {
		protocols h1
	}
}

{$CAPTURE_DOMAIN} {
	request_body {
		max_size 300MB
	}
	reverse_proxy 127.0.0.1:8765
	log {
		output discard
	}
}
