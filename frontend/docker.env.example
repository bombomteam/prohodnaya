# Copy these values into a local env file for docker run --env-file.
# This file contains no secrets. Browser-visible configuration is public.
FRONTEND_MODE=demo

# For API on the same Docker network, switch to api and use:
# API_UPSTREAM=http://backend:8000
# API_BASE_URL=/api

# For API on a separate public HTTPS origin, use instead:
# API_BASE_URL=https://api.example.org/api
