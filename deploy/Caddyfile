# HTTPS-прокси стенда. Домены и порты — из .env сервера (deploy/compose.stand.yaml).
# После правки этого файла пайплайн перезапускает caddy.
{
	# API управления Caddy выключен: в сети хоста он был бы доступен любому процессу.
	admin off
	skip_install_trust
}

# Проверка «жив ли» для healthcheck контейнера, только с этой машины.
http://127.0.0.1:8099 {
	bind 127.0.0.1
	respond /healthz 200
}

# Приложение: фронт и API бэкенда на одном адресе (CORS не нужен).
{$SITE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /api/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy 127.0.0.1:{$BACKEND_PORT}
	}
	handle {
		reverse_proxy 127.0.0.1:{$FRONTEND_PORT}
	}
}

# Keycloak. Админка, master realm и служебные пути наружу закрыты:
# администрировать через `deploy/dc exec keycloak /opt/keycloak/bin/kcadm.sh ...`.
{$AUTH_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@internal path /admin /admin/* /realms/master /realms/master/* /health /health/* /metrics /metrics/*
	respond @internal 404
	reverse_proxy 127.0.0.1:{$KC_PORT}
}

# Страница загрузки фото модуля face (face/tools/capture, запущена вне compose).
{$CAPTURE_DOMAIN} {
	request_body {
		max_size 300MB
	}
	reverse_proxy 127.0.0.1:8765
	log {
		output discard
	}
}

# Консоль модуля face (камера с рамками, MJPEG) — только по паролю. Запущена вне compose.
# CONSOLE_PASS_HASH — bcrypt в base64: caddy hash-password | base64 -w0. Если не задан, действует
# хеш случайного забытого пароля, т.е. консоль закрыта для всех.
{$CONSOLE_DOMAIN:console.localhost} {
	basic_auth {
		{$CONSOLE_USER:team} {$CONSOLE_PASS_HASH:JDJhJDE0JGNlYkJFdE5Lc0tMdnJGUE8ya3hkMHVEVDdDNklWcDdXM0tKajdkOE9MU21TRExPZ0U3eUZHCg==}
	}
	reverse_proxy 127.0.0.1:{$CONSOLE_PORT:8030} {
		# MJPEG: отдавать кадры сразу, без буферизации; к консоли — только HTTP/1.1.
		flush_interval -1
		transport http {
			versions 1.1
		}
	}
	log {
		output discard
	}
}
